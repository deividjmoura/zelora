{
  "name": "@zelora/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist",
    "test:postgres": "npm run build && node --test dist/db/migrate.postgres.test.js dist/db/postgres-users.postgres.test.js",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/cli/migrate.ts up",
    "db:rollback": "tsx src/cli/migrate.ts down",
    "db:status": "tsx src/cli/migrate.ts status"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1"
  }
}
