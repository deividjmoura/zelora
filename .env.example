# Local API configuration
PORT=3000

# PostgreSQL connection string. Set this in your local .env; do not commit credentials.
# Format: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=
# Apply pending migrations automatically when the API starts (optional).
AUTO_MIGRATE=false

# Backend-only Firebase Admin credentials (never expose as VITE_*).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local Firebase Auth emulator alternative; requires FIREBASE_PROJECT_ID only.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public web configuration only. Never put private keys in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
