# Local API configuration
PORT=3000

# PostgreSQL is optional until persistence is wired into API routes.
# Keep real credentials in your local environment/secret manager only.
DATABASE_URL=
PG_POOL_MAX=10

# Firebase Admin uses Application Default Credentials in the server runtime.
# Do not put service-account private keys here or commit credential files.
# Configure GOOGLE_APPLICATION_CREDENTIALS outside the repository when needed.

# Public web configuration only. Never put private keys in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
